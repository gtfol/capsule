{
  "manifest_version": 3,
  "name": "Capsule",
  "version": "0.1.0",
  "description": "Add the product page you're viewing to your Capsule wardrobe or wishlist.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Add to Capsule",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/capsule-16.png",
      "32": "icons/capsule-32.png"
    }
  },
  "icons": {
    "16": "icons/capsule-16.png",
    "32": "icons/capsule-32.png",
    "48": "icons/capsule-48.png",
    "128": "icons/capsule-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
