# All fields below are optional. Wardrobe storage works without configuration.
# Use a separate Supabase project and run db/schema.sql in its SQL editor.
# Use the session pooler connection string from Supabase Connect (port 5432).
DATABASE_URL=
# Optional Supabase root certificate (PEM) if its server requires a custom CA.
# Remote Postgres connections always verify TLS, including with sslmode=require.
DATABASE_SSL_CA=
# Generate a unique secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave unset for Google-only sign-in. Set to 1 to expose email/password.
EMAIL_PASSWORD_AUTH=
# Guests use a session-only key. Signed-in users can save an encrypted key.
# Generate a separate encryption secret: openssl rand -base64 32
# Keep this secret out of the database; losing it makes saved keys unreadable.
RENDER_KEY_ENCRYPTION_KEY=
# No server OpenAI key is consumed by the public rendering endpoint.
OUTFIT_RENDERING_ENABLED=true
OPENAI_IMAGE_MODEL=gpt-image-2
# Product analytics (PostHog). Leave unset to disable analytics entirely.
# The project API key is public by design; it is safe in the client bundle.
NEXT_PUBLIC_POSTHOG_KEY=
# https://us.i.posthog.com (default) or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
